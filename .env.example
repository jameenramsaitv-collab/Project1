# ==========================================
# Google Gemini API Key (Required)
# Get key at: https://aistudio.google.com/app/api-keys
# ==========================================
GEMINI_API_KEY=paste_your_gemini_api_key_here

# ==========================================
# SMTP Real Email Dispatch (Optional)
# Configure these to send real emails to employees.
# If left blank, emails are saved locally to sent_emails/
# ==========================================
# For Gmail:
# 1. Enable 2-Step Verification in Google Account
# 2. Generate an App Password at: https://myaccount.google.com/apppasswords
# 3. Set SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASSWORD=your_16_char_app_password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=Acme HR Support <no-reply@acmecorp.internal>

